# ─────────────────────────────────────────────
#  Unity .gitignore
#  KEPT in Git: Assets/ (with its .meta files), Packages/manifest.json + packages-lock.json, ProjectSettings/
# ─────────────────────────────────────────────

# Unity generated folders (rebuilt automatically)
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset meta data should ALWAYS be kept (*.meta holds the GUIDs; without it all references break)
# !*.meta  <- nothing to do: just do NOT ignore them

# Autogenerated VS / Rider / VSCode project files (Unity regenerates them)
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# IDE folders
/.vs/
/.vscode/
/.idea/
/.gradle/
*.DotSettings.user
_ReSharper*/

# Unity3D generated meta / crash / dump files
*.pidb.meta
*.pdb.meta
*.mdb.meta
sysinfo.txt
crashlytics-build.properties
mono_crash.*

# Builds & packages
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app
*.ipa

# Autogenerated Jetbrains Rider plugin
/Assets/Plugins/Editor/JetBrains*

# Addressables / StreamingAssets build output
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treaming[Aa]ssets/aa.meta
/[Aa]ssets/[Ss]treaming[Aa]ssets/aa/*

# OS files
.DS_Store
Thumbs.db
Desktop.ini
*~